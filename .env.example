# ── Client (public, safe to expose — RLS protects data) ──
# Copy to `.env` and fill from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# ── Seeding only (SECRET — never commit) ──
# Put this in `.env.local`, not `.env`. Dashboard → Settings → API → service_role.
# Used exclusively by scripts/seed.mjs to bulk-load content (bypasses RLS).
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
